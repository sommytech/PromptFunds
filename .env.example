# --- Database (Neon recommended: use the -pooler host for DATABASE_URL) ---
DATABASE_URL=postgresql://pf:pf@localhost:5432/promptfunds
DIRECT_URL=postgresql://pf:pf@localhost:5432/promptfunds
APP_URL=http://localhost:3000

# --- Security ---
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
# Used to hash BVN/NIN for duplicate detection (any long random string)
IDENTITY_HASH_SECRET=change-me
# Bearer token that scheduled functions use to call /api/cron/*
CRON_SECRET=change-me
# Initial password for seeded staff accounts (change after first login)
SEED_ADMIN_PASSWORD=ChangeMe-Now-12345

# --- Payments: mock | paystack ---
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_DVA_BANK=wema-bank
# Used only by the mock provider's signed test webhook
PAYMENT_WEBHOOK_SECRET=change-me

# --- Identity verification: mock | dojah ---
KYC_PROVIDER=mock
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_BASE_URL=https://api.dojah.io
# true = approve automatically when BVN name matches; false = officer approves
KYC_AUTO_APPROVE=false

# --- Demo / sandbox ---
# true shows a "simulate deposit" button and demo logins. NEVER enable with real money.
DEMO_MODE=false
