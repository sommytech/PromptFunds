{
  "name": "prompt-funds",
  "version": "1.0.0",
  "private": true,
  "description": "Prompt Funds — member savings wallet and loans platform (cooperative). No inter-bank or third-party transfers.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "netlify:build": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "job:accrue": "tsx src/jobs/run.ts accrue",
    "job:credit": "tsx src/jobs/run.ts credit",
    "job:arrears": "tsx src/jobs/run.ts arrears",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^16.6.1",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@netlify/functions": "^2.8.2",
    "@netlify/plugin-nextjs": "^5.16.5",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^7.10.1",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
